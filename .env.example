# ---------------------------------------------------------------------
# CarZone configuration template
# Copy this file to ".env" (same folder) and fill in DB_PASSWORD.
# Everything else has a sensible default.
# NEVER commit .env to GitHub (it is listed in .gitignore).
# Deploying to Render + TiDB Cloud? See .env.production.example and docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------

# Web server
PORT=3000
# HOST defaults to localhost (only this PC). With NODE_ENV=production it defaults to
# 0.0.0.0 (all network interfaces), which a cloud server needs.
# HOST=localhost

# development (default) or production. production = Secure cookies, trust proxy,
# 0.0.0.0 binding and a REQUIRED SESSION_SECRET. Leave it unset on your PC.
# NODE_ENV=development

# MySQL 8 connection (database created by database/carzone_db.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carzone_db
# TLS/SSL to the database: false for a local MySQL, true for TiDB Cloud (port 4000).
DB_SSL=false
# Optional PEM file of a private certificate authority (not needed for TiDB Cloud).
# DB_SSL_CA=certs/ca.pem
# Alternative to the five DB_* lines above - one URL (special characters in the
# password must be URL-encoded, e.g. @ -> %40, # -> %23, / -> %2F):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/carzone_db?ssl=true

# Secret used to sign session cookies (HMAC-SHA256).
# Leave empty locally to let the app generate one and store it in the app_settings table.
# REQUIRED (32+ random characters) when NODE_ENV=production.
SESSION_SECRET=

# Behind a reverse proxy (Render, Nginx): read the client IP / https from X-Forwarded-*.
# Default: true in production, false otherwise.
# TRUST_PROXY=false
# Session cookie only over https. Default: true in production, false otherwise.
# Set COOKIE_SECURE=false only to test a production build on plain http://localhost.
# COOKIE_SECURE=false
# Public address of the site, used in log messages (Render sets RENDER_EXTERNAL_URL itself).
# PUBLIC_URL=https://carzone.onrender.com

# How long a login lasts (hours). "Remember me" keeps it for REMEMBER_ME_DAYS.
SESSION_TTL_HOURS=12
REMEMBER_ME_DAYS=30

# Demo mode: the password-reset link is shown on screen and printed in the terminal
# instead of being e-mailed (there is no mail server in a local demo or on the free
# public demo). Keep it true unless you add real e-mail sending.
DEMO_MODE=true
RESET_TOKEN_TTL_MINUTES=15

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=10

# Wash business rules (rupees / hours / days)
GST_PERCENT=18
PICKUP_FEE_RUPEES=199
FREE_CANCEL_HOURS=24
LATE_CANCEL_REFUND_PERCENT=50
MAX_RESCHEDULES=2
MIN_HOURS_BEFORE_RESCHEDULE=2
BOOKING_WINDOW_DAYS=30

# Accessories store rules
FREE_SHIPPING_ABOVE_RUPEES=999
SHIPPING_FEE_RUPEES=79
FITMENT_FEE_RUPEES=299
RETURN_WINDOW_DAYS=7
LOW_STOCK_THRESHOLD=5
PAYMENT_EXPIRY_MINUTES=15

# Razorpay (optional, TEST mode). Leave empty to use the built-in payment simulator.
# Free test keys: https://dashboard.razorpay.com -> switch to Test mode -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you configure a webhook (Settings -> Webhooks) pointing to /api/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Log every HTTP request to the terminal (true/false)
LOG_REQUESTS=true
