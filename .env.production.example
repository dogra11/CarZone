# =====================================================================
# CarZone - PRODUCTION settings template (Render web service + TiDB Cloud Starter)
#
# These values are NOT read from a file on Render. Type them in the Render dashboard:
#   your service > Environment > Add Environment Variable
# (render.yaml already fills in the fixed ones). This file only lists them, with examples.
#
# You can also copy it to ".env" on your PC to run `npm run db:setup` against TiDB
# (then switch .env back to your local MySQL). NEVER commit a file with real passwords.
# Full guide: docs/DEPLOYMENT.md
# =====================================================================

# --- Set automatically by render.yaml ---------------------------------
NODE_ENV=production
NODE_VERSION=22
TZ=Asia/Kolkata
DEMO_MODE=true
DB_SSL=true
# Render generates this (generateValue: true). Elsewhere: 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Copy from TiDB Cloud > your instance > Connect --------------------
DB_HOST=gateway01.ap-south-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxxxxxxxxx.root
DB_PASSWORD=
DB_NAME=carzone_db

# ...or instead of the five DB_* lines, one URL (URL-encode special characters
# in the password: @ -> %40, # -> %23, / -> %2F, : -> %3A):
# DATABASE_URL=mysql://xxxxxxxxxxxxxxx.root:PASSWORD@gateway01.ap-south-1.prod.aws.tidbcloud.com:4000/carzone_db?ssl=true

# --- Do NOT set on Render ---------------------------------------------
# PORT  : Render sets it (10000) and the app listens on it automatically.
# HOST  : production default is 0.0.0.0, which is what Render needs.

# --- Optional ---------------------------------------------------------
# Razorpay TEST keys (otherwise the built-in payment simulator is used)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Only to test the production build on plain http://localhost:
# COOKIE_SECURE=false
